{
  "name": "nodejs-project-management",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run tests",
    "test:coverage": "vitest run tests --coverage",
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc && node scripts/fix-esm-imports.mjs",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepare": "husky",
    "db:migrate": "tsx src/database/migration-runner.ts up",
    "db:migrate:prod": "node dist/database/migration-runner.js up",
    "db:migrate:undo": "tsx src/database/migration-runner.ts down",
    "db:migrate:undo:all": "tsx src/database/migration-runner.ts down:all",
    "db:migrate:user": "tsx src/database/migration-runner.ts up 004-create-users.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addymistrel/nodejs-project-management.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#/config": "./dist/config/index.js",
    "#/constants": "./dist/constants/index.js",
    "#/database": "./dist/database/index.js",
    "#/types": "./dist/types/index.js",
    "#/utils": "./dist/utils/index.js",
    "#/middlewares": "./dist/middlewares/index.js",
    "#/validators": "./dist/validators/index.js",
    "#/repositories": "./dist/repositories/index.js",
    "#/services": "./dist/services/index.js",
    "#/controllers": "./dist/controllers/index.js",
    "#/routes": "./dist/routes/index.js",
    "#/docs": "./dist/docs/index.js",
    "#/*": "./dist/*"
  },
  "bugs": {
    "url": "https://github.com/addymistrel/nodejs-project-management/issues"
  },
  "homepage": "https://github.com/addymistrel/nodejs-project-management#readme",
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
