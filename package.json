{
  "name": "nodejs-project-management",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "db:migrate": "tsx src/database/migration-runner.ts up",
    "db:migrate:undo": "tsx src/database/migration-runner.ts down",
    "db:migrate:undo:all": "tsx src/database/migration-runner.ts down:all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addymistrel/nodejs-project-management.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#/config": {
      "development": "./src/config/index.ts",
      "types": "./src/config/index.ts",
      "default": "./dist/config/index.js"
    },
    "#/constants": {
      "development": "./src/constants/index.ts",
      "types": "./src/constants/index.ts",
      "default": "./dist/constants/index.js"
    },
    "#/database": {
      "development": "./src/database/index.ts",
      "types": "./src/database/index.ts",
      "default": "./dist/database/index.js"
    },
    "#/types": {
      "development": "./src/types/index.ts",
      "types": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "#/utils": {
      "development": "./src/utils/index.ts",
      "types": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    },
    "#/middlewares": {
      "development": "./src/middlewares/index.ts",
      "types": "./src/middlewares/index.ts",
      "default": "./dist/middlewares/index.js"
    },
    "#/validators": {
      "development": "./src/validators/index.ts",
      "types": "./src/validators/index.ts",
      "default": "./dist/validators/index.js"
    },
    "#/repositories": {
      "development": "./src/repositories/index.ts",
      "types": "./src/repositories/index.ts",
      "default": "./dist/repositories/index.js"
    },
    "#/services": {
      "development": "./src/services/index.ts",
      "types": "./src/services/index.ts",
      "default": "./dist/services/index.js"
    },
    "#/controllers": {
      "development": "./src/controllers/index.ts",
      "types": "./src/controllers/index.ts",
      "default": "./dist/controllers/index.js"
    },
    "#/routes": {
      "development": "./src/routes/index.ts",
      "types": "./src/routes/index.ts",
      "default": "./dist/routes/index.js"
    },
    "#/*": {
      "development": "./src/*",
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "bugs": {
    "url": "https://github.com/addymistrel/nodejs-project-management/issues"
  },
  "homepage": "https://github.com/addymistrel/nodejs-project-management#readme",
  "dependencies": {
    "archiver": "^8.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
